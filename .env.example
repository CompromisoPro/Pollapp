# =====================================================================
#  Variables de entorno de Pollapp
#  Copia este archivo como ".env.local" y rellena con los datos de tu
#  proyecto de Supabase (Project Settings > API).
#  NUNCA subas .env.local a GitHub (ya está ignorado por .gitignore).
# =====================================================================

# URL del proyecto (Supabase > Project Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave pública "anon" (Supabase > Project Settings > API > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...tu-anon-key...

# Clave SECRETA "service_role" (Supabase > Project Settings > API > service_role)
# ¡Solo se usa en el servidor! No lleva NEXT_PUBLIC_ y jamás llega al navegador.
SUPABASE_SERVICE_ROLE_KEY=eyJ...tu-service-role-key...
